{
  "name": "polymarbot",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:admin": "pnpm --filter @polymarbot/app-admin dev",
    "dev:app": "pnpm --filter @polymarbot/app-app dev",
    "dev:homepage": "pnpm --filter @polymarbot/app-homepage dev",
    "build:admin": "pnpm --filter @polymarbot/app-admin build",
    "build:app": "pnpm --filter @polymarbot/app-app build",
    "build:homepage": "pnpm --filter @polymarbot/app-homepage build",
    "dev:all": "pnpm -r dev",
    "build:all": "pnpm -r build",
    "prepare:all": "pnpm -r prepare",
    "typecheck:all": "vue-tsc --noEmit && pnpm -r typecheck",
    "typecheck:changed": "pnpm -r --if-present --filter '...[HEAD]' typecheck",
    "lint:all": "git add . && lint-staged --config .lintstagedrc.root.lint-only.json && pnpm -r --workspace-concurrency=1 lint",
    "format:all": "git add . && lint-staged --config .lintstagedrc.root.json && pnpm -r --workspace-concurrency=1 format",
    "i18n:build:all": "pnpm -r i18n:build",
    "db:generate": "nuxt prepare && pnpm db:app:generate && pnpm db:admin:generate && pnpm db:bot:generate && pnpm db:logs:generate",
    "db:admin:generate": "dotenv -c -- prisma generate --config=prisma/admin/prisma.config.ts",
    "db:admin:push": "dotenv -c -- prisma db push --config=prisma/admin/prisma.config.ts",
    "db:admin:studio": "dotenv -c -- prisma studio --config=prisma/admin/prisma.config.ts",
    "db:app:generate": "dotenv -c -- prisma generate --config=prisma/app/prisma.config.ts",
    "db:app:push": "dotenv -c -- prisma db push --config=prisma/app/prisma.config.ts",
    "db:app:studio": "dotenv -c -- prisma studio --config=prisma/app/prisma.config.ts",
    "db:bot:generate": "dotenv -c -- prisma generate --config=prisma/bot/prisma.config.ts",
    "db:bot:pull": "dotenv -c -- prisma db pull --config=prisma/bot/prisma.config.ts",
    "db:bot:studio": "dotenv -c -- prisma studio --config=prisma/bot/prisma.config.ts",
    "db:logs:generate": "dotenv -c -- prisma generate --config=prisma/bot_logs/prisma.config.ts",
    "db:logs:pull": "dotenv -c -- prisma db pull --config=prisma/bot_logs/prisma.config.ts",
    "db:logs:studio": "dotenv -c -- prisma studio --config=prisma/bot_logs/prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@prisma/client-runtime-utils": "catalog:"
  },
  "devDependencies": {
    "@intlify/core-base": "^11.3.2",
    "@nuxt/eslint": "^1.15.2",
    "@nuxtjs/i18n": "^10.2.4",
    "@nuxtjs/robots": "^6.0.7",
    "@nuxtjs/sitemap": "^8.0.12",
    "@polymarbot/eslint-config-shared": "^0.2.4",
    "@polymarbot/uitls-shared": "^0.1.1",
    "@sentry/nuxt": "^10.48.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@vitest/ui": "^4.1.4",
    "defu": "^6.1.7",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.2.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "lodash-es": "^4.18.1",
    "nuxt": "^4.4.2",
    "nuxt-security": "^2.5.1",
    "postcss-pxtorem": "^6.1.0",
    "prisma": "^7.7.0",
    "sass": "^1.99.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "unplugin": "^3.0.0",
    "unplugin-vue-markdown": "^30.0.0",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ],
    "overrides": {
      "@noble/hashes": "1.8.0",
      "typescript": "^6.0.2"
    },
    "ignoredBuiltDependencies": [
      "@sentry/cli"
    ]
  },
  "packageManager": "pnpm@10.14.0"
}
