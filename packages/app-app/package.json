{
  "name": "@polymarbot/app-app",
  "type": "module",
  "scripts": {
    "dev": "../../scripts/env.sh nuxt dev",
    "build": "../../scripts/env.sh nuxt build",
    "generate": "nuxt generate",
    "preview": "../../scripts/env.sh nuxt preview",
    "prepare": "nuxt prepare",
    "typecheck": "nuxt prepare && nuxt typecheck",
    "lint": "git add . && lint-staged --config ../../.lintstagedrc.lint-only.json",
    "format": "git add . && lint-staged --config ../../.lintstagedrc.json",
    "i18n:build": "tsx ../../scripts/i18n/build --packages layer-basic --packages layer-auth && pnpm i18n:fix:alignment",
    "i18n:check:undefined": "tsx ../../scripts/i18n/checkUndefinedKeys --packages layer-basic --packages layer-auth",
    "i18n:check:unused": "tsx ../../scripts/i18n/checkUnusedKeys --packages layer-basic --packages layer-auth",
    "i18n:fix:unused": "tsx ../../scripts/i18n/checkUnusedKeys --packages layer-basic --packages layer-auth --fix && pnpm i18n:build",
    "i18n:fix:alignment": "tsx ../../scripts/i18n/checkI18nAlignment --fix"
  },
  "dependencies": {
    "@polymarbot/layer-auth": "workspace:*",
    "@polymarbot/layer-basic": "workspace:*",
    "@polymarket/builder-relayer-client": "catalog:",
    "@polymarbot/shared": "catalog:",
    "echarts": "catalog:",
    "primevue": "catalog:",
    "viem": "catalog:",
    "vue-echarts": "catalog:",
    "zod": "catalog:"
  }
}
